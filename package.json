{
  "name": "kerbside-ops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant ordering platform demo app for Clumio recovery scenarios",
  "scripts": {
    "prestart": "node scripts/require-install.js",
    "start": "node server.js",
    "setup": "node scripts/setup.js",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "precheck-access": "node scripts/require-install.js",
    "check-access": "node scripts/check-access.js",
    "preseed": "node scripts/require-install.js",
    "seed": "node scripts/seed.js",
    "prebad-deploy": "node scripts/require-install.js",
    "bad-deploy": "node scripts/bad-deploy.js",
    "pres3-delete-incident": "node scripts/require-install.js",
    "s3-delete-incident": "node scripts/s3-delete-incident.js",
    "pres3-corrupt-incident": "node scripts/require-install.js",
    "s3-corrupt-incident": "node scripts/s3-corrupt-incident.js",
    "preverify": "node scripts/require-install.js",
    "verify": "node scripts/verify.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "express": "^4.21.0"
  },
  "engines": {
    "node": ">=20"
  }
}
